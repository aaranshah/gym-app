# ── Required ────────────────────────────────────────────────────────────────
# Anthropic API key (https://platform.claude.com → API keys).
# Used only on the server; never sent to the browser.
ANTHROPIC_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Model for rewriting/correction. Default: claude-opus-5-5 (best fidelity).
# claude-sonnet-5-5 is roughly half the price and faster, with some quality cost.
# HUMANISER_MODEL=claude-opus-5-5

# Model for the meaning-verification step. Defaults to HUMANISER_MODEL.
# HUMANISER_VERIFY_MODEL=claude-opus-5-5

# Per-client limits (in-memory, single instance).
# HUMANISER_RATE_LIMIT_PER_MIN=12
# HUMANISER_MAX_CONCURRENT=2

# Demo engine: a deterministic stand-in used by the automated UI tests.
# It is NOT real AI rewriting, and the UI labels it "Demo engine" when on.
# HUMANISER_MOCK=1
